# --- Required (no defaults) ---------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wayfinder
BETTER_AUTH_SECRET=replace-with-32-byte-random-string-1 # Use: `openssl rand -hex 32` to generate a new one
SETTINGS_ENCRYPTION_KEY=replace-with-32-byte-random-string-2 # Use: `openssl rand -hex 32` to generate a new one