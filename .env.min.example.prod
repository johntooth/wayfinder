# Smallest .env that runs Wayfinder as a DEPLOYMENT.
# For local development use .env.min.example.dev instead.
#
# Shorter than it looks: the difference from the dev minimum is that the four
# vars whose defaults point at localhost have to be told the real hostname, and
# NODE_ENV has to say production. Everything else still has a working default,
# and the integrations (AI, object storage, mail, n8n, Entra) are configured
# in-app by the first-run setup wizard and stored encrypted in the database —
# they are deliberately NOT environment variables here.
#
# See .env.example for the full set of overrides, and
# docs/guides/setup-railway.md for a worked deployment.

NODE_ENV=production

# --- Required (no defaults) ---------------------------------------
# Point at your managed Postgres. The instance must have the pgvector
# extension available; the migrations create it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/wayfinder
# Generate each of these with `openssl rand -hex 32`. Use distinct values, and
# treat them as deployment secrets — they are not rotatable without cost.
#   BETTER_AUTH_SECRET      signs sessions; changing it signs everyone out.
#   SETTINGS_ENCRYPTION_KEY encrypts the integration credentials the setup
#                           wizard stores. LOSING IT MAKES THOSE ROWS
#                           UNREADABLE and every integration has to be
#                           reconfigured, so back it up.
BETTER_AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=

# --- Required in production (the defaults are localhost) ----------
# The public origin the app is served on, with no trailing slash. Sign-in
# callbacks, the first-run /setup link and the links inside notification emails
# are all built from it, so a wrong value here breaks sign-in rather than
# degrading quietly. BETTER_AUTH_URL is read by the web app and WEB_BASE_URL by
# the API; set both to the same public URL unless the API reaches the web app
# on a private address, in which case give WEB_BASE_URL that one.
BETTER_AUTH_URL=https://wayfinder.example.com
WEB_BASE_URL=https://wayfinder.example.com

# Shared secret the API's scheduler heartbeat presents to the web app's
# internal tick endpoint, which refuses an unauthenticated tick. BOTH processes
# must see the same value. Without it the API logs "Scheduler enabled but not
# started" and scheduled sessions never fire.
SCHEDULER_TICK_SECRET=

# --- Worth setting once you have load -----------------------------
# Per-instance Postgres pool. Size it so DATABASE_POOL_MAX × instances stays
# under the server's max_connections, ideally behind a transaction-mode pooler.
DATABASE_POOL_MAX=10

# --- Optional: skip the wizard for object storage -----------------
# Leave these out to configure storage in the setup wizard (recommended — it
# tests the connection before accepting it). Set them only for an env-only
# install; a stored config always wins over these. For Amazon S3:
#   MINIO_ENDPOINT=s3.<region>.amazonaws.com
#   MINIO_USE_SSL=true
#   MINIO_REGION=<region>     S3 signs with the bucket's region.
#   MINIO_PATH_STYLE=false    S3 wants virtual-hosted addressing; MinIO needs true.
