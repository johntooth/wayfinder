# Smallest .env that boots Wayfinder for LOCAL DEVELOPMENT.
# For a deployment use .env.min.example.prod instead.
#
# Everything omitted here has a working default, and every integration (AI,
# storage, mail, n8n, Entra) is configured in-app by the first-run setup
# wizard. See .env.example for the full set of overrides.
#
# You do not normally need this file at all: ./restart.sh seeds .env from
# .env.example and generates the secrets below for you.

# --- Required (no defaults) ---------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wayfinder
BETTER_AUTH_SECRET=replace-with-32-byte-random-string-1 # Use: `openssl rand -hex 32` to generate a new one
SETTINGS_ENCRYPTION_KEY=replace-with-32-byte-random-string-2 # Use: `openssl rand -hex 32` to generate a new one

# --- Needed before scheduled sessions can fire --------------------
# The API's heartbeat presents this to the web app's internal tick endpoint,
# which refuses an unauthenticated tick. Both processes must see the same
# value. Without it the API logs "Scheduler enabled but not started".
SCHEDULER_TICK_SECRET=replace-with-32-byte-random-string-3 # Use: `openssl rand -hex 32` to generate a new one
