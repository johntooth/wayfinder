{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // __fixtures__ holds test doubles that were previously inline in the spec
  // files, where "**/*.test.ts" already exempted them. They implement only the
  // slice of each port a spec exercises, so typechecking them would demand
  // stub methods no test calls. Excluded to keep the split behaviour-neutral —
  // vitest still runs everything that uses them.
  "exclude": ["node_modules", "**/*.test.ts", "src/**/__fixtures__/**"]
}
